# =====================================================================================================
# OPflow backend — environment variables
#
# Copy to `.env` for local work. On staging/production set these as secrets on the host (Fly.io
# `fly secrets set …`), never in git. The API refuses to start if a REQUIRED value is missing or malformed
# (validated with zod in src/config/env.ts).
#
# NOT here on purpose: business rules (10% fee, 2-hour cut-off, hold minutes, kill switches, minimum app
# version…). They live in the `app_config` table so they can change without a redeploy.
#
# Legend:  [required]  must be set in every environment
#          [prod]      required on staging/production, optional locally
#          [optional]  has a safe default or turns a feature on
# =====================================================================================================


# ── Runtime ─────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                       # [required] development | production
APP_ENV=local                              # [required] local | staging | production (Sentry, logs, safety checks)
PROCESS_TYPE=api                           # [required] api | worker — same image, two processes
PORT=3000                                  # [required] HTTP + WebSocket port for the api process
TZ=UTC                                     # [required] keep UTC; IST is applied in code, never by the OS
LOG_LEVEL=info                             # [optional] trace | debug | info | warn | error
TRUST_PROXY=true                           # [prod] behind Fly/Cloudflare, so client IPs are read correctly

API_PUBLIC_URL=http://localhost:3000       # [required] used in links, webhook docs and signed URLs
WEB_PUBLIC_URL=http://localhost:3001       # [required] landing site (privacy/terms links in emails)
ADMIN_PUBLIC_URL=http://localhost:3002     # [required] admin site (links in admin alert emails)
CORS_ORIGINS=http://localhost:3002         # [required] comma-separated; only the admin site (the app is not a browser)


# ── Database: Supabase Postgres (region: Mumbai, ap-south-1) ────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL: what the running API/worker use. Transaction pooler (Supavisor, port 6543), logged in as
# `opflow_api` (created by migration …001500; set its password once in the SQL editor). NEVER the
# `postgres` user: it can bypass row-level security.
#   - The username includes the project ref:  opflow_api.<project-ref>
#   - `pgbouncer=true` / `connection_limit` are for other tools; the API reads host, user and password from the URL
#     and sets SSL and pool size itself (src/infra/db/db.service.ts).
#   - Our RLS settings use set_config(…, true) = per transaction, which is exactly what transaction pooling needs.
DATABASE_URL=postgresql://opflow_api.<project-ref>:<opflow_api-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require   # [required]
#
# DIRECT_URL: migrations (dbmate) and `npm run db:types` only. Session mode / direct connection (port 5432),
# logged in as `postgres` (needs DDL rights). Used by CI and by developers, never by the running app.
DIRECT_URL=postgresql://postgres.<project-ref>:<postgres-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require   # [required for migrations]
#
DB_POOL_MAX=10                             # [optional] connections per process (Supabase plan limits apply)
DB_STATEMENT_TIMEOUT_MS=5000               # [optional] 5 s; hot paths set 1 s themselves
# Supabase's CA certificate, base64 on one line (Dashboard → Database → SSL configuration → Download certificate;
# then `base64 -w0 prod-ca-2021.crt`). Required on staging/production so the database certificate is verified.
DB_SSL_CA_B64=                             # [prod]
SUPABASE_PROJECT_REF=<project-ref>         # [optional] for the Supabase CLI (backups, branching); not used at runtime
#
# Not needed: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY. OPflow uses Supabase only as
# Postgres. Its REST API and Auth are not used, and the anon key must never ship in the app.
# (If you later choose Supabase Storage instead of Cloudflare R2, see the Storage section.)


# ── Redis: Upstash (region: Mumbai) ─────────────────────────────────────────────────────────────────
# The TCP URL (rediss://), not the REST URL: BullMQ and Socket.IO need a real Redis connection.
REDIS_URL=   # e.g. rediss://default:<password>@<name>.upstash.io:6379 · optional until 2+ API machines · [required] cache, locks, pub/sub, BullMQ jobs
REDIS_KEY_PREFIX=opflow:local:             # [optional] keeps environments apart if they ever share a Redis


# ── Auth: our own tokens ────────────────────────────────────────────────────────────────────────────
# Access tokens are signed with Ed25519 (EdDSA). Generate a key pair:
#   openssl genpkey -algorithm ed25519 -out access.pem && openssl pkey -in access.pem -pubout -out access.pub.pem
# Store each PEM base64-encoded on one line (base64 -w0 access.pem).
JWT_ACCESS_PRIVATE_KEY_B64=                # [required] signs access tokens (api only)
JWT_ACCESS_PUBLIC_KEY_B64=                 # [required] verifies access tokens (api + WebSocket)
JWT_KEY_ID=2026-09                         # [required] `kid` header; change it when rotating keys (every 90 days)
JWT_PREVIOUS_PUBLIC_KEY_B64=               # [optional] old public key, still accepted during a rotation
JWT_PREVIOUS_KEY_ID=                       # [optional]
JWT_ISSUER=https://api.opflow.in           # [required]
JWT_ACCESS_TTL_SECONDS=900                         # [optional] access token life, default 900 (15 min)
REFRESH_TOKEN_TTL_DAYS=30                  # [optional] default 30
ADMIN_SESSION_TTL_HOURS=8                  # [optional] default 8
ADMIN_IDLE_MINUTES=30                      # [optional] admin signed out after 30 min without activity

# Extra secret mixed into doctor/admin password hashes (argon2id). Losing it = everyone resets passwords.
PASSWORD_PEPPER=                           # [required] 32+ random bytes, base64

# Column encryption (pgcrypto): patient notes, admin TOTP secrets, verification document keys.
DATA_ENCRYPTION_KEY=                       # [required] 32+ random bytes, base64 — back it up safely
DATA_ENCRYPTION_KEY_PREVIOUS=              # [optional] during key rotation


# ── Firebase: patient OTP login + push notifications ────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key (JSON).
# The app gets its own config files (google-services.json / GoogleService-Info.plist); these are for the server.
FIREBASE_PROJECT_ID=            # e.g. opflow-prod · [required] verifies patients' Firebase ID tokens
FIREBASE_CLIENT_EMAIL=   # e.g. firebase-adminsdk-xxxx@opflow-prod.iam.gserviceaccount.com · [required]
FIREBASE_PRIVATE_KEY_B64=                  # [required] the service account private key, base64 (avoids newline issues)
PHONE_LOGIN=                               # [optional] sms (default on servers) | firebase | demo (local/demo only)


# ── MSG91: backup OTP provider (switch with app_config `otp.provider = "msg91"`) ─────────────────────
MSG91_AUTH_KEY=                            # [optional] needed only when MSG91 is switched on
MSG91_OTP_TEMPLATE_ID=                     # [prod] DLT OTP template for patient login codes (text uses ##OTP##)
MSG91_SMS_TEMPLATE_ID=                     # [optional] DLT-approved template id
MSG91_SENDER_ID=OPFLOW                     # [optional]


# ── Razorpay: payments, refunds, doctor payouts (Route) ─────────────────────────────────────────────
# Dashboard → Settings → API Keys. Test keys (rzp_test_…) on local/staging, live keys only in production.
RAZORPAY_KEY_ID=      # e.g. rzp_test_xxxxxxxxxxxx · [required] also sent to the app to open Checkout (it is public)
RAZORPAY_KEY_SECRET=                       # [required] server only: creates orders, verifies signatures
# Dashboard → Settings → Webhooks → URL: {API_PUBLIC_URL}/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed, transfer.processed,
#         transfer.failed, transfer.reversed
RAZORPAY_WEBHOOK_SECRET=                   # [required] verifies webhook signatures
RAZORPAY_ROUTE_ENABLED=true                # [optional] false = keep the full amount (before Route is approved)
RAZORPAY_TIMEOUT_MS=5000                   # [optional]


# ── File storage: Cloudflare R2 (doctor photos public via CDN, documents private) ───────────────────
# Cloudflare dashboard → R2 → Manage API tokens (Object Read & Write, limited to these two buckets).
R2_ACCOUNT_ID=                             # [required]
R2_ACCESS_KEY_ID=                          # [required]
R2_SECRET_ACCESS_KEY=                      # [required]
R2_BUCKET_PUBLIC=opflow-photos             # [required] doctor photos (resized WebP)
R2_BUCKET_PRIVATE=opflow-documents         # [required] verification documents; 5-minute signed reads only
CDN_PUBLIC_BASE_URL=   # e.g. https://photos.opflow.in · [required] public URL in front of the photos bucket
UPLOAD_MAX_BYTES=5242880                   # [optional] 5 MB
# Alternative, fewer vendors: Supabase Storage (S3-compatible). Put its S3 endpoint, key and secret in the
# same variables and set STORAGE_PROVIDER=supabase.
STORAGE_PROVIDER=                        # r2 | supabase | local (empty = R2 when its keys are set, else local files in development) · [optional] r2 | supabase
S3_ENDPOINT=                               # [optional] only for Supabase Storage (its S3 endpoint); R2 uses R2_ACCOUNT_ID
S3_REGION=auto                             # [optional] R2: auto · Supabase: your project region


# ── Email: Resend ───────────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                            # [prod] locally, emails are printed to the log instead
EMAIL_FROM="OPflow <no-reply@opflow.in>"   # [required] domain must be verified in Resend
EMAIL_REPLY_TO=support@opflow.in           # [optional]
ADMIN_ALERT_EMAIL=alerts@opflow.in         # [prod] invariant failures, stuck refunds, reconcile mismatches


# ── Admin site security ─────────────────────────────────────────────────────────────────────────────
ADMIN_ALLOWED_IPS=                         # [prod] comma-separated office/VPN IPs; empty = allow all (local only)
ADMIN_TOTP_ISSUER=OPflow Admin             # [optional] name shown in the authenticator app


# ── Observability ───────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=                                # [prod] errors from api + worker (personal data scrubbed)
SENTRY_TRACES_SAMPLE_RATE=0.1              # [optional]
OTEL_EXPORTER_OTLP_ENDPOINT=               # [optional] traces (Grafana Cloud / Honeycomb…)
OTEL_SERVICE_NAME=opflow-api               # [optional]


# ── Worker ──────────────────────────────────────────────────────────────────────────────────────────
JOBS_IN_API=                               # [optional] run background jobs inside the API too (default: yes locally, no on servers)
WORKER_CONCURRENCY=10                      # [optional] parallel jobs per worker process
OUTBOX_POLL_MS=1000                        # [optional] how often the outbox relay checks for new rows
HOLD_SWEEP_SECONDS=30                      # [optional] safety sweep for expired holds


# ── Maps (optional) ─────────────────────────────────────────────────────────────────────────────────
# Only the admin site uses this, to turn a typed hospital address into lat/lng. Patients' "Directions" opens
# Google/Apple Maps by link and needs no key.
GOOGLE_MAPS_API_KEY=                       # [optional] restrict it to the Geocoding API + the admin site's server


# =====================================================================================================
# For reference — set elsewhere, not in this file
#
# Flutter app (build-time: `flutter build … --dart-define=KEY=value`):
#   BACKEND=staging | prod | mock
#   API_BASE_URL=https://api.opflow.in/v1
#   WS_URL=wss://api.opflow.in/live
#   RAZORPAY_KEY_ID=rzp_live_…           (public key only)
#   SENTRY_DSN_APP=…
#   + Firebase files: android/app/google-services.json, ios/Runner/GoogleService-Info.plist
#
# Admin site (Next.js, admin/.env):
#   NEXT_PUBLIC_API_BASE_URL=https://api.opflow.in/v1
#   SENTRY_DSN_ADMIN=…
#
# GitHub Actions secrets: DIRECT_URL (migrations), FLY_API_TOKEN (deploys), SENTRY_AUTH_TOKEN (source maps).
# =====================================================================================================

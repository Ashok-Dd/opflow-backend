{
  "name": "opflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OPflow API and worker (NestJS). See docs/ARCHITECTURE.md.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:db": "jest --runInBand src/app.e2e-spec.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file src/infra/db/schema.ts --camel-case --date-parser string --exclude-pattern schema_migrations",
    "test:flow": "jest --runInBand src/flows.e2e-spec.ts",
    "admin:create": "ts-node --transpile-only scripts/admin-create.ts",
    "seed:demo": "ts-node --transpile-only scripts/seed-demo.ts",
    "keys:generate": "node scripts/generate-keys.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "@sentry/node": "^9.47.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.28.17",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
